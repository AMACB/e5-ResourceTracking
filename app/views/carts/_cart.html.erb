<h1>My Cart</h1>

<% if !@order_item.nil? && @order_item.errors.any? %>
  <div class="alert alert-danger">
    <ul>
    <% @order_item.errors.full_messages.each do |e| %>
      <li><%= e %></li>
    <% end %>
    </ul>
  </div>
<% end %>
<% if checkout_items.size == 0 %>
  <p class="text-center">
    There are no items in your shopping cart.  Please <%= link_to "go back", items_path %> and add some items to your cart.
  </p>
<% else %>
<div class="carttable container-fluid">
  <div class="row bg-primary text-light">
    <div class="col-6 table-item table-item-head"><strong>Item Name</strong></div>
    <div class="col table-item table-item-head"><strong>Category</strong></div>
    <div class="col table-item table-item-head"><strong>Quantity</strong></div>
    <div class="col table-item table-item-head"></div>
    <div class="col table-item table-item-head"></div>
  </div>
  <% checkout_items.each do |c| %>
    <%= form_for c, remote: true, authenticity_token: true do |f| %>
      <div class="row <%= cycle('bg-white', 'bg-light') %>">
        <%= f.hidden_field :item_id, value: c.item.id %>
        <div class="col-6 table-item"><%= c.item.name %></div>
        <div class="col table-item"><%= c.item.category.name %></div>
        <div class="col table-item"><%= f.number_field :quantity, value: c.quantity.to_i, min: 1, class: "form-control" %></div>
        <div class="col table-item">
          <%= f.submit "Update Quantity", class: "btn btn-primary submittable" %>
          <%# this form refuses to submit when AJAX'd %>
        </div>
        <div class="col table-item">
          <%= link_to "Delete", c, class: "btn btn-danger", role: "button", remote: true, data: {confirm: "Are you sure you want to delete this item?", method: "delete"} %>
          <%# this link works fine always %>
        </div>
      </div>
    <% end %>
  <% end %>
</table>
<% end %>