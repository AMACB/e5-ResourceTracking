<% content_for :title, "Your Checkout Requests - APRD Resource Management" %>
<%= render 'layouts/navbar', active: 'requests' %>

<div class="card card-body">
	<h1>My Requests</h1>

	<% @checkouts.each do |c| %>
		<div class="card bg-light text-dark">
			<div class="card-body">
				<h5 class="card-title text-center"><%= c.checkout_time.in_time_zone("Central Time (US & Canada)").strftime("%-I:%M %p %b %-d, %Y") %></h5>
				<p class="lead">Reason: <%= c.reason %></p>
				<% if c.notes.present? %>
					<p>Notes: <%= c.notes %></p>
				<% end %>
				<p>Requested By: <%= c.need_by.strftime("%b %-d, %Y") %></p>
				<p>Return By: <%= c.return_by.strftime("%b %-d, %Y") %></p>
				<ul class="listgroup">
					<% citems = c.checkout_items%>
					<% citems.each do |i| %>
						<li class="list-group-item"><%= i.item.name %> <span class="badge badge-pill badge-dark"><%= i.quantity %></span></li>
					<% end %>
				</ul>
				<% case (c.status) %>
				<% when 1 %>
					<div class="alert alert-warning">
						Status: Pending approval
						<br>
						<small>Your request is awaiting approval in an admin review queue.</small>
					</div>
				<% when 2 %>
					<div class="alert alert-success">
						Status: Approved
						<br>
						<small>Your request has been approved. Your items will be available for pickup on the "Requested By" date.</small>
					</div>
				<% end %>
			</div>
		</div>
	<% end %>
</div>