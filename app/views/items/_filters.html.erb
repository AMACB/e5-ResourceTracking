<div style="margin: 12px">
	<p>
		<button class="btn btn-primary btn-lg" type="button" data-toggle="collapse" data-target="#filtersCollapse" aria-expanded="false" aria-controls="filtersCollapse">
			Filters
		</button>
	</p>
	<div class="collapse show" id="filtersCollapse">
		<div class="card card-body">
			<%= form_with url: '/items', method: :get, local: true, class: "form-inline" do |f| %>
			<div class="form-group">
				<%= f.label :q, "Search:", class: "form-control" %>
				<%= f.text_field :q, value: @filters[:q], class: "form-control" %>
			</div>
			<div class="form-group">
				<%= f.label :category, "Category", class: "form-control" %>
				<%= f.collection_select :category, Category.all, :id, :name, { selected: @filters[:category], include_blank: "All" }, class: "form-control" %>
			</div>
			<div class="form-group">
				<%= f.label :date_begin, "Available From: ", class: "form-control" %>
				<%= f.text_field :date_begin, class: "form-control", 'data-provide': "datepicker", 'data-date-format': 'yyyy-mm-dd', 'data-startDate': '0', 'data-todayHighlight': true, value: @filters[:date_begin] %>
				<%= f.label :date_end, "Until: ", class: "form-control" %>
				<%= f.text_field :date_end, class: "form-control", 'data-provide': "datepicker", 'data-date-format': 'yyyy-mm-dd', 'data-startDate': '0', 'data-todayHighlight': true, value: @filters[:date_end] %>
			</div>
			<br>
			<div class="form-group">
				<%= f.submit "Filter", name: nil, class: "form-control btn-primary"  %>
			</div>
			<% end %>
		</div>
	</div>
</div>
