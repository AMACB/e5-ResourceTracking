<div class="row <%= cycle('bg-white', 'bg-light') %>">
	<div class="col-2 table-item name"><%= link_to i.name, item_path(i) %></div>
	<div class="col-2 table-item"><%= i.category.name %></div>
	<div class="col-3 table-item description"><%= i.description.nil? ? nil : (i.description[0..100].to_s + "...") %></div>
	<div class="col-2 table-item notes"><%= i.notes %></div>
	<div class="col-1 table-item age"><%= i.age %></div>
	<div class="col-1 table-item available"><%= i.available %></div>
	<%# <td class="price"><%= i.price.nil? ? nil : number_to_currency(i.price / 100.0) %>
	</td>
	<% if current_user %>
		<% if i.available <= 0 %>
			<div class="col-1 table-item add-to-cart text-muted">
				<em>None available</em>
			</div>
		<% elsif checked_out_items.include? i.id %>
			<div class="col-1 table-item add-to-cart text-muted">
				<% if newly_added %>
					<em>Added</em>
				<% else %>
					<em>Already added</em>
				<% end %>
			</div>
		<% else %>
			<%= form_for checkout_item, remote: true do |f| %>
			<%= f.hidden_field :item_id, value: i.id %>
			<div class="col-1 table-item add-to-cart">
				<%= f.number_field :quantity, value: 1, min: 1, max: i.available, class: "form-control", style: "width: 75px" %>
				<%= f.submit "Add", class: "btn btn-sm btn-primary", id: "add_item_#{i.id}"%>
			</div>
			<% end %>
		<% end %>
	<% end %>
</div>