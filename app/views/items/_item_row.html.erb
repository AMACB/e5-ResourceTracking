<% cname = i.category.name %>
<% unless filters.nil?; max_available = i.available_date_range(filters[:date_begin], filters[:date_end]); end %>
<div class="row zebra <%= cycle('bg-white', 'bg-light') %>">
	<div class="col-2 table-item name"><%= i.name %></div>
	<div class="col-2 table-item"><%= cname %></div>
	<div class="<%= current_user ? 'col-3' : 'col-4' %> table-item description"><%= i.description.nil? ? nil : (i.description.size > 80 ? i.description[0..80].to_s + "..." : i.description) %></div>
	<div class="<%= current_user ? 'col-2' : 'col-3' %> table-item"><button class="btn btn-info" data-toggle="modal" data-target="#item_show_<%= i.id %>">More Info</button></div>	
	<div class="col-1 table-item available"><%= !requested_items.nil? and requested_items.include?(i.id) ?  nil : max_available%></div>
	<%# <td class="price"><%= i.price.nil? ? nil : number_to_currency(i.price / 100.0) %>
	<% if current_user %>
		<% if max_available.nil? %>
			<div class="col-2 table-item add-to-cart text-muted">
				<em>Added</em>
			</div>
		<% else %>
			<% if max_available <= 0 %>
				<div class="col-2 table-item add-to-cart text-muted">
					<em>None available</em>
				</div>
			<% elsif !requested_items.nil? and requested_items.include? i.id %>
				<div class="col-2 table-item add-to-cart text-muted">
					<% if newly_added %>
						<em>Added</em>
					<% else %>
						<em>Already added</em>
					<% end %>
				</div>
			<% else %>
				<div class="col-2 form-row table-item add-to-cart">
					<%= form_for request_item, url: { controller: "request_items", action: "create" }, remote: true, class: "form-inline" do |f| %>
						<%= f.hidden_field :item_id, value: i.id %>
						<div class="form-group row">
							<%= f.number_field :quantity, value: 1, min: 1, max: i.available, class: "form-control", style: "width: 75px" %>
							<%= button_tag type: "submit", class: "btn btn-md btn-primary", id: "add_item_#{i.id}" do %>
								<%= octicon 'plus', fill: 'white', class: "align-middle text-center" %>
							<% end %>
						</div>
					<% end %>
				</div>
			<% end %>
		<% end %>
	<% end %>
</div>

<div id="item_show_<%= i.id %>" class="modal fade" role="dialog">
<div class="modal-dialog modal-xl">
	<div class="modal-content">
		<div class="modal-header">
			<h4 class="modal-title"><%= i.name %></h4>
			<button type="button" class="close" data-dismiss="modal" onclick="">&times;</button>
		</div>
		<div class="modal-body">
			<div class="container">
				<div class="row">
					<div class="col-2">
						<strong>Category</strong>
					</div>
					<div class="col">
						<%= cname %>
					</div>
				</div>
				<br>
				<div class="row">
					<div class="col-2">
						<strong>Description</strong>
					</div>
					<div class="col">
						<%= i.description %>
					</div>
				</div>
				<br>
				<% if i.notes.present? %>
					<div class="row">
						<div class="col-2">
							<strong>Notes</strong>
						</div>
						<div class="col">
							<%= i.notes %>
						</div>
					</div>
					<br>
				<% end %>
				<div class="row">
					<div class="col-2">
						<strong>Ages</strong>
					</div>
					<div class="col">
						<%= i.age %>
					</div>
				</div>
				<br>
				<% if i.price.present? %>
					<div class="row">
						<div class="col-2">
							<strong>Price</strong>
						</div>
						<div class="col">
							<%= number_to_currency(i.price / 100.0) %>
						</div>
					</div>
					<br>
				<% end %>
				<div class="row">
					<div class="col-2">
						<strong>Total Available</strong>
					</div>
					<div class="col">
						<%= i.available %>
					</div>
				</div>
				<br>
				<div class="row">
					<button class="load-img-button btn btn-info" data-class="img-fluid img-center" data-alt="<%= i.name %>" data-rel="<%= i.image %>">Load Image</button>
					<!--<%= image_tag i.image, alt: "#{i.name}", class: "img-fluid img-center" %>-->
				</div>
			</div>
		</div>
		<div class="modal-footer">
			<button type="button" class="btn btn-default" data-dismiss="modal" onclick="// $('#edit_item_<%= i.id %>')[0].reset()">Close</button>
		</div>
	</div>
</div>
</div>