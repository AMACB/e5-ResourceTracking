<div class="row <%= cycle('bg-white', 'bg-light') %>">
	<div class="col-2 table-item name"><%= link_to i.name, item_path(i) %></div>
	<div class="col table-item category"><%= i.category.name %></div>
	<div class="col-4 table-item description"><%= i.description.nil? ? nil : (i.description[0..100].to_s + "...") %></div>
	<div class="col table-item notes"><%= i.notes %></div>
	<div class="col table-item age"><%= i.age %></div>
	<div class="col table-item available"><%= i.available %></div>
	<%# <td class="price"><%= i.price.nil? ? nil : number_to_currency(i.price / 100.0) %>
	</td>
	<% if current_user %>
		<%= form_for checkout_item, remote: true do |f| %>
		<%= f.hidden_field :item_id, value: i.id %>
		<div class="col table-item add-to-cart-qty"><%= f.number_field :quantity, value: 1, min: 1, class: "form-control" %></div>
		<div class="col table-item add-to-cart"><%= f.submit "Add to Cart", class: "btn btn-sm btn-primary" %> </div>
		<% end %>
	<% end %>
</div>