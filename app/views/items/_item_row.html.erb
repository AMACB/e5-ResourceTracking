<% unless filters.nil?; max_available = i.available_date_range(filters[:date_begin], filters[:date_end]); end %>
<div class="row zebra <%= cycle('bg-white', 'bg-light') %>">
	<div class="col-2 table-item name"><%= link_to i.name, item_path(i) %></div>
	<div class="col-2 table-item"><%= i.category.name %></div>
	<div class="<%= current_user ? 'col-3' : 'col-4' %> table-item description" data-toggle="tooltip" data-placement="right" data-trigger="click" title="<%= i.description.nil? ? nil : i.description %>"><%= i.description.nil? ? nil : (i.description.size > 200 ? i.description[0..200].to_s + "..." : i.description) %></div>
	<div class="<%= current_user ? 'col-2' : 'col-3' %> table-item notes"><%= i.notes %></div>	
	<div class="col-1 table-item available"><%= !checked_out_items.nil? and checked_out_items.include?(i.id) ?  nil : max_available%></div>
	<%# <td class="price"><%= i.price.nil? ? nil : number_to_currency(i.price / 100.0) %>
	</td>
	<% if current_user %>
		<% if max_available.nil? %>
			<div class="col-2 table-item add-to-cart text-muted">
				<em>Added</em>
			</div>
		<% else %>
			<% if max_available <= 0 %>
				<div class="col-2 table-item add-to-cart text-muted">
					<em>None available</em>
				</div>
			<% elsif checked_out_items.include? i.id %>
				<div class="col-2 table-item add-to-cart text-muted">
					<% if newly_added %>
						<em>Added</em>
					<% else %>
						<em>Already added</em>
					<% end %>
				</div>
			<% else %>
				<div class="col-2 form-row table-item add-to-cart">
					<%= form_for checkout_item, url: { controller: "checkout_items", action: "create" }, remote: true, class: "form-inline" do |f| %>
						<%= f.hidden_field :item_id, value: i.id %>
						<div class="form-group row">
							<%= f.number_field :quantity, value: 1, min: 1, max: i.available, class: "form-control", style: "width: 75px" %>
							<%= button_tag type: "submit", class: "btn btn-md btn-primary", id: "add_item_#{i.id}" do %>
								<%= octicon 'plus', fill: 'white', class: "align-middle text-center" %>
							<% end %>
						</div>
					<% end %>
				</div>
			<% end %>
		<% end %>
	<% end %>
</div>