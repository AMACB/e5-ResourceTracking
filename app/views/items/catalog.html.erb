<% content_for :title, "Catalog - APRD Resource Management" %>
<%= render 'layouts/navbar', active: 'catalog' %>

<% if current_user and current_request.return_by.blank? and current_request.need_by.blank? %>
<div class="mg12">
<div class="alert alert-warning">
	Before you begin adding items to your cart, it is recommended that you first go to <%= link_to "your cart", cart_path, class: "alert-link" %> and set a need by and return by date for the items you need.
</div>
</div>
<% end %>
<div class="jumbotron">
	<div class="container">
		<h1>Item Catalog</h1>
		<%= form_tag items_path, method: 'get' do %>
		<p class="lead">
			<div class="input-group mb-3">
				<input name="q" type="text" class="form-control form-control-lg" placeholder="Search" aria-label="Search" aria-describedby="search-btn">
				<% if current_user and current_request.present? %>
					<input name="date_begin" type="hidden" value="<%= current_request.need_by %>">
					<input name="date_end" type="hidden" value="<%= current_request.return_by %>">
				<% end %>
				<div class="input-group-append">
					<button id="search-btn" class="btn btn-primary" type="submit"><%= octicon 'search', fill: 'white', class: 'align-middle' %></button>
				</div>
			</div>
		</p>
		<% end %>
	</div>
</div>
<div class="container-fluid">
	<h2 class="text-center">
		Choose a Category
	</h2>
	<hr>
	<div class="d-flex justify-content-around flex-wrap" style="">
		<div class="card text-black bg-light" style="width: 18rem; margin-bottom: 12px;">
			<div class="card-body">
				<h5 class="card-title text-center"><%= link_to "All", items_path %></h5>
			</div>
		</div>
		<% @categories.each do |c| %>
			<div class="card text-black bg-light" style="width: 18rem; margin-bottom: 12px;">
				<div class="card-body">
					<h5 class="card-title text-center"><%= link_to c.name, items_path(category: c.id, date_begin: current_request.nil? ? nil : current_request.need_by, date_end: current_request.nil? ? nil : current_request.return_by) %></h5>
					<p class="card-text"><%= c.description %></p>
				</div>
			</div>
		<% end %>
	</div>
</div>