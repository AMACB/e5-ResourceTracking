<%= form_for(@item) do |f| %>
	<div class="field">
		<%= f.label "Editing Item" %><br>
		<%= f.text_field :name, placeholder: "Name" %><br>
		<%= collection_select(:item, :category_id, Category.all, :id, :name) %><br>
		<%= f.text_area :description, placeholder: "Description" %><br>
		<%= f.text_area :notes, placeholder: "Notes" %><br>
		<%= f.select :condition, [["New", 4], ["Very Good", 3], ["Good", 2], ["Fair", 1], ["Poor", 0]] %><br>
		<%= f.text_field :age, placeholder: "Ages" %><br>
		<%= f.text_field :quantity, placeholder: "Quantity" %><br>
		<%= f.text_field :price, placeholder: "Price (cents)" %><br>
		<%= f.text_field :image, placeholder: "Image URL" %><br>
	</div>
	<div class="action">
		<%= f.submit "Save Changes" %>
		<%= link_to "Cancel", item_path(@item), data: {"confirm": "Discard changes?"} %>
	</div>
<% end %>