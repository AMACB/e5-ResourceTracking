<div class="header">
	<nav class="navbar navbar-expand-lg">
		<ul class="navbar-nav">
			<li class="nav-item"><%= link_to "Home", "/", class: "nav-link" %></li>
		</ul>
	</nav>
	<nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top">
		<ul class="navbar-nav">
			<li class="nav-item"><%= link_to "Home", "/", class: "nav-link" %></li>
			<li class="nav-item active"><%= link_to "Items", items_path, class: "nav-link" %></li>
			<% if current_user && current_user.admin? %>
				<li class="nav-item"><%= link_to "New Item", "/items/new", class: "nav-link" %></li>
			<% end %>
			<li class="nav-item cart-text"><%= render 'layouts/cart_text' %></li>
		</ul>
	</nav>
</div>

<table class="itemstable tables-responsive table table-striped" style="padding-top: 60px;">
	<thead>
		<tr class="tableheader">
			<th>Name</th>
			<th>Category</th>
			<th>Description</th>
			<th>Notes</th>
			<th>Age</th>
			<th>Quantity</th>
			<% if current_user %>
				<th></th>
				<th></th>
			<% end %>
			<% if current_user && current_user.admin? %>
				<th></th>
				<th></th>
				<th>Time Created</th>
			<th>Time Updated</th>
			<% end %>
		</tr>
	</thead>
	<tbody> 
		<% @items.each do |i| %>
		<%= render "item_row", i: i, checkout_item: @checkout_item %>
		<% end %>
	</tbody>
</table>