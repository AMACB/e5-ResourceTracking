<%= render 'layouts/navbar', active: 'items' %>

<div class="itemstable container-fluid">
	<div class="row tableheader bg-primary text-light">
		<div class="col-2 name table-item table-item-head">Name</div>
		<div class="col category table-item table-item-head">Category</div>
		<div class="col-4 description table-item table-item-head">Description</div>
		<div class="col note table-item table-item-head">Notes</div>
		<div class="col age table-item table-item-head">Age</div>
		<div class="col quantity table-item table-item-head">Quantity</div>
		<% if current_user %>
			<div class="col table-item table-item-head"></div>
			<div class="col table-item table-item-head"></div>
		<% end %>
	</div>
	<div class="items-body"> 
		<%= render 'items/items_all', items: @items %>
	</div>
</table>