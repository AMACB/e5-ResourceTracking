<% content_for :title, "All Items - APRD Resource Management" %>
<%= render 'layouts/navbar', active: '' %>

<div class="filters">
	<%= render 'items/filters' %>
</div>

<div class="itemstable container-fluid">
	<div class="row tableheader bg-primary text-light">
		<div class="col-2 name table-item table-item-head">Name</div>
		<div class="col-2 table-item table-item-head">Category</div>
		<div class="<%= current_user ? 'col-3' : 'col-4' %> description table-item table-item-head">Description</div>
		<div class="<%= current_user ? 'col-2' : 'col-3' %> notes table-item table-item-head">Notes</div>
		<div class="col-1 available table-item table-item-head">No. Available</div>
		<% if current_user %>
			<div class="col-2 table-item table-item-head"></div>
		<% end %>
	</div>
	<span class="items-body"> 
		<% if @items.size == 0 %>
			<div class="jumbotron" style="display: inline-flex; width: 100%; height: 100%">
				<div class="container">
					<h2>Nothing to see here.</h2>
					<p class="lead">We couldn't find any items that matched your filters.</p>
					<hr class="my-4">
					<p class="lead">
						<%= link_to "Go Back", items_catalog_path, class: "btn btn-primary btn-lg", role: "button" %>
					</p>
				</div>
			</div>
		<% else %>
			<%= render 'items/items_all', items: @items, checked_out_items: @checked_out_items, filters: @filters %>
		<% end %>
	</span>
</table>