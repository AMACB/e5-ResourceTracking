<%= render 'layouts/navbar', active: 'items' %>

<div class="itemstable container-fluid">
	<tr class="tableheader">
		<th>Name</th>
		<th>Category</th>
		<th>Description</th>
		<th>Notes</th>
		<th>Age</th>
		<th>Quantity</th>
		<% if current_user %>
			<th></th>
			<th></th>
		<% end %>
	</tr>
	<div class="items-body"> 
		<%= render 'items_all', items: @items %>
	</div>
</table>