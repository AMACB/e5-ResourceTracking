<% content_for :title, "Manage Items - APRD Resource Management" %>
<%= render 'layouts/navbar', active: 'manage-items' %>

<div class="itemstable container-fluid">
	<div class="row tableheader bg-primary text-light">
		<div class="col-2 table-item table-item-head">Name</div>
		<div class="col table-item table-item-head">Category</div>
		<div class="col-2 table-item table-item-head">Description</div>
		<div class="col-2 table-item table-item-head">Notes</div>
		<div class="col table-item table-item-head">Age</div>
		<div class="col table-item table-item-head">Price</div>
		<div class="col table-item table-item-head">T - U - CO - A <span class="align-middle text-center" data-toggle="tooltip" data-placement="bottom" title="Total - Unavailable - Checked Out - Available"> <%= octicon 'question', fill: 'white' %></span></div>
		<div class="col table-item table-item-head">
			<span class="new-button align-middle text-center"><button type="button" class="btn btn-light" data-toggle="modal" data-target="#new_item"><%= octicon "plus", fill: "black", class: "align-middle text-center" %> New</button></span>
		</div>

		<div id="new_item" class="modal fade" role="dialog">
			<%= form_for @new_item, remote: true, authenticity_token: true, id: "new_item_form" do |f| %>
				<div class="modal-dialog">
					<div class="modal-content">
						<div class="modal-header">
							<h4 class="modal-title text-dark">New Item</h4>
							<button type="button" class="close" data-dismiss="modal">&times;</button>
						</div>
						<div class="modal-body">
							<div class="field">
								<div class=""><%= f.text_field :name, placeholder: "Name", class: "form-control" %></div>
								<div class=""><%= collection_select(:item, :category_id, Category.all, :id, :name, class: "form-control" ) %></div>
								<div class=""><%= f.text_area :description, placeholder: "Description", class: "form-control" %></div>
								<div class=""><%= f.text_area :notes, placeholder: "Notes", class: "form-control" %></div>
								<div class=""><%= f.select :condition, [["New", 4], ["Very Good", 3], ["Good", 2], ["Fair", 1], ["Poor", 0]], {}, class: "form-control" %></div>
								<div class=""><%= f.text_field :age, placeholder: "Ages", class: "form-control" %></div>
								<div class=""><%= f.number_field :price, placeholder: "Price (cents)", class: "form-control" %></div>
								<div class=""><%= f.number_field :unavailable, placeholder: "No. Unavailable", class: "form-control" %></div>
								<div class=""><%= f.number_field :total, placeholder: "No. Total", class: "form-control" %></div>
								<div class=""><%= f.text_field :image, placeholder: "Image URL", class: "form-control" %></div>
							</div>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
							<%= f.submit "Create", class: "btn btn-primary" %>
						</div>
					</div>
				</div>
			<% end %>
		</div>
		
	</div>
	<div class="items-body">
		<%= render 'items/items_manage_all', items: @items %>
	</div>
</div>