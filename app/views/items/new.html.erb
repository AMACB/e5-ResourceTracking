<%= form_for(@item) do |f| %>
	<div class="field">
		<%= f.label :item %><br>
		<%= f.text_field :name, placeholder: "Name" %><br>
		<%= collection_select(:item, :category_id, Category.all, :id, :name) %><br>
		<%= f.text_area :description, placeholder: "description" %><br>
		<%= f.select :condition, [["New", 4], ["Very Good", 3], ["Good", 2], ["Fair", 1], ["Poor", 0]] %><br>
	</div>
	<div class="action">
		<%= f.submit "Create" %>
	</div>
<% end %>