<div class="header">
	<nav class="navbar navbar-expand-lg">
		<ul class="navbar-nav">
			<li class="nav-item"><%= link_to "Home", "/", class: "nav-link" %></li>
		</ul>
	</nav>
	<nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top">
		<ul class="navbar-nav">
			<li class="nav-item active"><%= link_to "Home", "/", class: "nav-link" %></li>
			<li class="nav-item mr-auto"><%= link_to "Items", items_path, class: "nav-link" %></li>

			<% unless current_user %>
				<li class="nav-item"><%= link_to "Login", '/login', class: "nav-link" %> </li>
				<li class="nav-item"><%= link_to "Sign up", '/signup', class: "nav-link" %> </li>
			<% else %>
				<li class="nav-item cart-text"><%= render 'layouts/cart_text' %></li>
				<li class="nav-item"><%= link_to "Logout", logout_path, method: "delete", class: "nav-link" %> </li>
			<% end %>
		</ul>
	</nav>
</div>
