<div class="card card-body">
	<h1>My Cart</h1>

	<div id="cart-errors">
		<%= render 'cart_errors', request_errors: request_errors %>
	</div>

	<%= form_with url: "cart", method: "patch" do |f| %>
		<div class="row">
			<div class="col-2">
				<%= f.label :requested_pick_up_date, "Pick up date:" %>
			</div>
			<div class="col">
				<%= f.text_field :requested_pick_up_date, value: request.requested_pick_up_date, class: "form-control", 'data-provide': "datepicker", 'data-date-format': 'yyyy-mm-dd', 'data-startDate': '0', 'data-todayHighlight': true, required: true %>
			</div>
		</div>
		<div class="row">
			<div class="col-2">
				<%= f.label :requested_return_date, "Return date:" %>
			</div>
			<div class="col">
				<%= f.text_field :requested_return_date, value: request.requested_return_date, class: "form-control", 'data-provide': "datepicker", 'data-date-format': 'yyyy-mm-dd', required: true %>
			</div>
		</div>
		<%= f.submit "Update Dates", class: "btn btn-primary" %>
		<hr>
	<% end %>
	<div class="align-left">
		<% if request_items.size != 0 %>
			<%= link_to "Check Out", checkout_begin_path, class: "btn btn-primary" %>
		<% else %>
			<p class="text-center">
				There are no items in your cart.  Please <%= link_to "go back", items_path %> and add some items to your cart.
			</p>
		<% end %>
	</div>
</div>

<% if !@order_item.nil? && @order_item.errors.any? %>
	<div class="alert alert-danger">
		<ul>
		<% @order_item.errors.full_messages.each do |e| %>
			<li><%= e %></li>
		<% end %>
		</ul>
	</div>
<% end %>
<% if request_items.size == 0 %>
	
<% else %>
<div class="carttable container-fluid">
	<div class="row bg-primary text-light">
		<div class="col-6 table-item table-item-head">Item Name</div>
		<div class="col table-item table-item-head">Category</div>
		<div class="col table-item table-item-head">No. Available</div>
		<div class="col table-item table-item-head">Quantity</div>
		<div class="col table-item table-item-head"></div>
		<div class="col table-item table-item-head"></div>
	</div>
	<div class="cartbody">
	<% request_items.each do |r| %>
		<div id="cart_row_<%= r.id %>">
			<%= render 'cart_row', r: r  %>
		</div>
	<% end %>
	</div>
</div>
<% end %>