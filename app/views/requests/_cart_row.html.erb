<%= form_for r, url: { controller: 'request_items', action: 'update', id: r.id }, remote: true, authenticity_token: true do |f| %>
  <div class="row zebra <%= cycle('bg-white', 'bg-light') %>">
    <%= f.hidden_field :item_id, value: r.item.id %>
    <div class="col-6 table-item"><%= r.item.name %></div>
    <div class="col table-item"><%= r.item.category.name %></div>
    <div class="col table-item"><%= r.item.available %></div>
    <div class="col table-item"><%= f.number_field :quantity, value: r.quantity.to_i, min: 1, max: r.item.available, class: "form-control" %></div>
    <div class="col table-item">
      <%= f.submit "Update Quantity", class: "btn btn-primary submittable" %>
    </div>
    <div class="col table-item">
      <%= link_to request_items_destroy_path(r.id), class: "btn btn-danger", role: "button", remote: true, data: {confirm: "Are you sure you want to delete this item?", method: "delete"} do %>
        <%= octicon("x", fill: "white", class: "align-middle text-center") %>
      <% end %>
    </div>
  </div>
<% end %>