<% content_for :title, "Reviewing Your Cart - APRD Resource Management" %>
<%= render 'layouts/navbar', active: '' %>

<div class="card card-body">
	<h1>Reviewing Your Cart</h1>
	<hr>
	<div class="align-left container container-fluid">
		<div id="cart-errors">
			<% if flash[:error] %>
				<ul class="list-group">
				<% flash[:error].each do |e| %>
					<li class="list-group-item list-group-item-danger"><%= e %></li>
				<% end %>
				</ul>
				<br>
			<% end %>
		</div>

		<div class="alert alert-warning">
			Currently, the only location available for picking up and returning items is the DeWitty Center, <strong><%= t 'info.address' %></strong>.
			<br><br>
			Barring special circumstances, you will only be able to pick up and return items on <strong><%= t 'info.hours' %></strong>.
			The DeWitty Center will also be closed on <%= link_to "City of Austin Holidays", "http://www.austintexas.gov/department/official-city-holidays", class: "alert-link" %>.
			<br><br>
			If you request your items on a date other than the ones specified above, be sure to explain why in the Notes section.
		</div>
		<ul class="list-group">
			<% @request_items.each do |r| %>
				<li class="list-group-item"><%= r.item.name %> <span class="badge badge-pill badge-dark"><%= r.quantity %></span></li>
			<% end %>
		</ul>
	</div>
	<br>
	<div class="container">
		<%= form_for @request, url: checkout_end_path do |f| %>
		<div class="row">
			<div class="col">
				<%= f.label :requested_pick_up_date, "When will you pick up these items?" %>
			</div>
			<div class="col">
				<%= f.text_field :requested_pick_up_date, class: "form-control", 'data-provide': "datepicker", 'data-date-format': 'yyyy-mm-dd', 'data-startDate': '0', 'data-todayHighlight': true, required: true %>
			</div>
		</div>
		<div class="row">
			<div class="col">
				<%= f.label :requested_return_date, "When will you return these items?" %>
			</div>
			<div class="col">
				<%= f.text_field :requested_return_date, class: "form-control", 'data-provide': "datepicker", 'data-date-format': 'yyyy-mm-dd', required: true %>
			</div>
		</div>
		<div class="row">
			<div class="col">
				<%= f.label :reason, "Why do you need these items?" %>
			</div>
			<div class="col">
				<%= f.text_field :reason, class: "form-control", placeholder: "Reason", required: true %>
			</div>
		</div>
		<div class="row">
			<div class="col">
				<%= f.label :notes, "Any additional notes?" %>
			</div>
			<div class="col">
				<%= f.text_field :notes, class: "form-control", placeholder: "Notes" %>
			</div>
		</div>
		<br>
		<div class="container-fluid" style="width: 300px">
			<%= f.submit "Submit", class: "form-control btn btn-primary btn-lg text-lg-center" %>
		</div>
		<br>
		<% end %>
		<div class="alert alert-dark">
			Once you press submit, your items will be put into a queue for admin review. You will be able to review the status of your requests <%= link_to "here", requests_path, class: "alert-link" %>. 
		</div>
	</div>
</div>