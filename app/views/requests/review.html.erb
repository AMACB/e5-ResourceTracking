<% content_for :title, "Reviewing Requests - APRD Resource Management" %>
<%= render 'layouts/navbar', active: 'review' %>

<% if flash[:error].present? %>
	<div class="alert alert-danger mg12">
		<%= flash[:error] %>
	</div>
<% end %>

<% if flash[:success].present? %>
	<div class="alert alert-success mg12">
		<%= flash[:success] %>
	</div>
<% end %>

<% if flash[:notice].present? %>
	<div class="alert alert-info mg12">
		<%= flash[:notice] %>
	</div>
<% end %>

<ul class="nav nav-pills mg12">
	<li class="nav-item">
		<a class="nav-link active" data-toggle="pill" href="#requests-pending">Pending</a>
	</li>
	<li class="nav-item">
		<a class="nav-link" data-toggle="pill" href="#requests-approved">Approved</a>
	</li>
	<li class="nav-item">
		<a class="nav-link" data-toggle="pill" href="#requests-rejected">Rejected</a>
	</li>
</ul>

<div class="tab-content">
	<div class="tab-pane container active" id="requests-pending">
		<% if @pending.size == 0 %>
			<div class="alert alert-info">
				There are currently no pending requests.
			</div>
		<% else %>
			<% @pending.each do |r| %>
				<div class="card bg-light text-dark">
					<div class="card-body">
						<h5 class="card-title text-center"><%= r.user.email %> at <%= r.checkout_time.in_time_zone("Central Time (US & Canada)").strftime("%-I:%M %p %b %-d, %Y") %></h5>
						<p class="lead">Request ID: <%= r.id %></p>
						<p class="lead">Reason: <%= r.reason %></p>
						<% if r.notes.present? %>
							<p>Notes: <%= r.notes %></p>
						<% end %>
						<p>Requested By: <%= r.requested_pick_up_date.strftime("%b %-d, %Y") %></p>
						<p>Return By: <%= r.requested_return_date.strftime("%b %-d, %Y") %></p>
						<ul class="listgroup">
							<% ritems = r.request_items %>
							<% ritems.each do |i| %>
								<li class="list-group-item"><%= i.item.name %> <span class="badge badge-pill badge-dark"><%= i.quantity %></span></li>
							<% end %>
						</ul>
						<hr>
						<%= form_with url: request_review_final_path, method: "post", local: true do |f| %>
							<%= f.hidden_field :request_id, value: r.id %>
							<div class="form-group">
								<%= f.label :review_notes, "Review Notes:" %>
								<%= f.text_field :review_notes, placeholder: "Notes/reason", class: "form-control" %>
							</div>
							<%= f.submit "Approve", class: "btn btn-success" %>
							<%= f.submit "Reject", class: "btn btn-danger" %>
						<% end %>
					</div>
				</div>
			<% end %>
		<% end %>
	</div>
	<div class="tab-pane container fade" id="requests-approved">
		<% if @approved.size == 0 %>
			<div class="alert alert-info">
				There are currently no approved requests.
			</div>
		<% else %>
			<% @approved.each do |r| %>
				<div class="card bg-light text-dark">
					<div class="card-body">
						<h5 class="card-title text-center"><%= r.user.email %> at <%= r.checkout_time.in_time_zone("Central Time (US & Canada)").strftime("%-I:%M %p %b %-d, %Y") %></h5>
						<p class="lead">Request ID: <%= r.id %></p>
						<p class="lead">Reason: <%= r.reason %></p>
						<% if r.notes.present? %>
							<p>Notes: <%= r.notes %></p>
						<% end %>
						<p>Requested By: <%= r.requested_pick_up_date.strftime("%b %-d, %Y") %></p>
						<p>Return By: <%= r.requested_return_date.strftime("%b %-d, %Y") %></p>
						<ul class="listgroup">
							<% ritems = r.request_items %>
							<% ritems.each do |i| %>
								<li class="list-group-item"><%= i.item.name %> <span class="badge badge-pill badge-dark"><%= i.quantity %></span></li>
							<% end %>
						</ul>
						<small>Approved <%= r.reviewed_at.nil? ? nil : time_ago_in_words(r.reviewed_at)  + ' ago' %><%= r.reviewed_by.nil? ? nil : " by " + r.reviewed_by.email %>.</small>
						<br>
						<% if r.review_notes.present? %><small>Review notes: <%= r.review_notes.to_s %></small><% end %>
					</div>
				</div>
			<% end %>
		<% end %>
	</div>
	<div class="tab-pane container fade" id="requests-rejected">
		<% if @rejected.size == 0 %>
			<div class="alert alert-info">
				There are currently no rejected requests.
			</div>
		<% else %>
			<% @rejected.each do |r| %>
				<div class="card bg-light text-dark">
					<div class="card-body">
						<h5 class="card-title text-center"><%= r.user.email %> at <%= r.checkout_time.in_time_zone("Central Time (US & Canada)").strftime("%-I:%M %p %b %-d, %Y") %></h5>
						<p class="lead">Request ID: <%= r.id %></p>
						<p class="lead">Reason: <%= r.reason %></p>
						<% if r.notes.present? %>
							<p>Notes: <%= r.notes %></p>
						<% end %>
						<p>Requested By: <%= r.requested_pick_up_date.strftime("%b %-d, %Y") %></p>
						<p>Return By: <%= r.requested_return_date.strftime("%b %-d, %Y") %></p>
						<ul class="listgroup">
							<% ritems = r.request_items %>
							<% ritems.each do |i| %>
								<li class="list-group-item"><%= i.item.name %> <span class="badge badge-pill badge-dark"><%= i.quantity %></span></li>
							<% end %>
						</ul>
						<small>Rejected <%= r.reviewed_at.nil? ? nil : time_ago_in_words(r.reviewed_at)  + ' ago' %><%= r.reviewed_by.nil? ? nil : " by " + r.reviewed_by.email %>.</small>
						<br>
						<% if r.review_notes.present? %><small>Review notes: <%= r.review_notes.to_s %></small><% end %>
					</div>
				</div>
			<% end %>
		<% end %>
	</div>
</div>