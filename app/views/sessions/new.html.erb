<% content_for :title, "Log In - APRD Resource Management" %>
<%= render 'layouts/navbar', active: 'login' %>

<div class="card card-body card-fluid bg-light">
	<h1>Log In</h1>
	<div class="container-fluid col-4">
		<% if flash[:error] %>
			<ul class="list-group">
			<% flash[:error].to_a.each do |e| %>
				<li class="list-group-item list-group-item-danger"><%= e %></li>
			<% end %>
			</ul>
			<br>
		<% end %>
		<div class="login container card card-body bg-faded">
			<%= form_for(:session, url: login_path) do |f| %>
			<div class="email">
				<%= f.email_field :email, placeholder: "Email", class: "form-control", required: true %>
			</div>
			<div class="password">
				<%= f.password_field :password, placeholder: "Password", class: "form-control", required: true %>
			</div>
			<div class="reset-link mgtop12 d-flex justify-content-between">
				<%= link_to "Need an account?", signup_path %>
				<%= link_to "Forgot your password?", password_reset_path %>
			</div>
			<div class="submit mgtop12">
				<%= f.submit "Login", class: "form-control btn btn-primary" %>
			</div>
			<% end %>
		</div>
	</div>
</div>
