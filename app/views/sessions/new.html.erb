<%= render 'layouts/navbar', active: 'login' %>
<div class="card card-body card-fluid bg-light">
	<h1>Log In</h1>
	<div class="container-fluid col-4">
		<% if flash[:error] %>
		<div class="alert alert-danger" role="alert">
			<% flash[:error].to_a.each do |e| %>
				<%= e %>
				<br>
			<% end %>
		</div>
		<% end %>
		<div class="login container card card-body bg-faded">
			<%= form_for(:session, url: login_path) do |f| %>
			<div class="email">
				<%= f.email_field :email, placeholder: "Email", class: "form-control" %>
			</div>
			<div class="password">
			 	<%= f.password_field :password, placeholder: "Password", class: "form-control" %>
			 </div>
			 <br>
			 <div class="submit">
				<%= f.submit "Login", class: "form-control btn btn-primary" %>
			</div>
			<% end %>
		</div>
	</div>
</div>
