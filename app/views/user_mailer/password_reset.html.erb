<h1 style="text-align: center;">Password Reset</h1>
<hr>
<p>
	A password reset was requested for your email, <strong><%= @user.email %></strong>. If you did not request this password reset, <strong>your account is safe</strong>. If you did, you can use the button below to reset your password. This link will expire in 24 hours.
</p>
<div style="text-align: center;">
	<div>
		<%= link_to raw('<button style="margin: auto; text-align: center; border: none; background-color: #28a745; border-radius: 12px; font-size: 24px; padding: 12px; color: white">Reset Your Password</button>'), controller: "users", action: "password_reset_final", only_path: false, password_reset_token: @token, user_id: @user.id %>
	</div>
	<br>
	<div>
		<em>
			Or, copy and paste this link into your browser: <%= link_to nil, controller: "users", action: "password_reset_final", only_path: false, password_reset_token: @token, user_id: @user.id %>
		</em>
	</div>
<p>
	Treat the above link like your password. If someone else obtains this link, they will be able to change your password.
</p>
</div>