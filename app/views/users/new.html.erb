<h1>Sign Up</h1>
<div class="container-fluid well well-sm">
	<% if flash[:error] %>
	<div class="alert alert-danger" role="alert">
		<% flash[:error].to_a.each do |e| %>
			<%= e %>
			<br>
		<% end %>
	</div>
	<% end %>
	<%= form_for(@user) do |f| %>
		<%= f.email_field :email, placeholder: "Email" %> <br>
		<%= f.password_field :password, placeholder: "Password" %> <br><br>
		<%= f.submit "Create an account" %> <br>
	<% end %>
</div>