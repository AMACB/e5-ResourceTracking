<% content_for :title, "Sign Up - APRD Resource Management" %>
<%= render 'layouts/navbar', active: 'signup' %>

<div class="card card-body card-fluid bg-light">
	<h1 class>Sign Up</h1>
	<div class="container-fluid col-4">
		<% if flash[:error] %>
			<ul class="list-group">
				<% flash[:error].to_a.each do |e| %>
					<li class="list-group-item list-group-item-danger"><%= e %></li>
				<% end %>
			</ul>
			<br>
		<% end %>
		<div class="signup container card card-body bg-faded">
			<%= form_for(@user) do |f| %>
			<div class="email form-group">
				<%= f.email_field :email, placeholder: "Email", class: "form-control", required: true %>
			</div>
			<div class="password form-group">
				<%= f.password_field :password, id: "password", placeholder: "Password", class: "form-control", required: true, pattern: ".{8,}", title: "Password must be at least 8 characters long" %>
				<%= f.password_field :password_confirmation, placeholder: "Confirm Password", class: "form-control", oninput: "check(this)" %>
			</div>
			 <script>
				function check(input) {
					if (input.value != $('#password')[0].value) {
						input.setCustomValidity('Passwords must match');
					} else {
						// input is valid -- reset the error message
						input.setCustomValidity('');
					}
				}
			</script>
			<div class="submit form-group">
				<%= f.submit "Create an account", class: "form-control btn btn-primary" %>
			</div>
			<% end %>
		</div>
	</div>
</div>