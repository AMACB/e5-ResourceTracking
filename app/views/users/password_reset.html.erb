<% content_for :title, "Reset Password - APRD Resource Management" %>
<%= render 'layouts/navbar', active: '' %>

<div class="card card-body card-fluid bg-light">
	<h1>Reset Password</h1>
	<% if flash[:success].present? || flash[:error].present? %>
		<ul class="list-group">
			<% if flash[:success].present? %><li class="list-group-item list-group-item-success"><%= flash[:success] %></li><% end %>
			<% if flash[:error].present? %><li class="list-group-item list-group-item-danger"><%= flash[:error] %></li><% end %>
		</ul>
		<br>
	<% else %>
		<div class="container-fluid col-4">
			<div class="password-reset container card card-body bg-faded">
				<%= form_with url: "password_reset", local: true do |f| %>
					<div class="email">
						<%= f.label :email, "Enter your email:" %>
						<%= f.email_field :email, placeholder: "Email", class: "form-control", required: true %>
					</div>
					<br>
					<%= f.submit "Send Reset Email", class: "btn btn-primary" %>
				<% end %>
			</div>
		</div>
	<% end %>
</div>