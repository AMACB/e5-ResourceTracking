<% content_for :title, "Profile - APRD Resource Management" %>
<%= render 'layouts/navbar', active: 'profile' %>

<div class="card card-body card-fluid bg-light">
	<h1>User Profile</h1>
	<ul class="nav nav-pills nav-fill mb-3" id="pills-tab" role="tablist">
		<li class="nav-item">
			<a class="nav-link active" id="pills-info-tab" data-toggle="pill" href="#pills-info" role="tab" aria-controls="pills-info" aria-selected="true">Info</a>
		</li>
		<li class="nav-item">
			<a class="nav-link" id="pills-account-tab" data-toggle="pill" href="#pills-account" role="tab" aria-controls="pills-account" aria-selected="false">Account</a>
		</li>
		<li class="nav-item">
			<a class="nav-link" id="pills-notifications-tab" data-toggle="pill" href="#pills-notifications" role="tab" aria-controls="pills-notifications" aria-selected="false">Notifications</a>
		</li>
	</ul>
	<div class="tab-content" id="pills-tabContent">
		<div class="tab-pane fade show active" id="pills-info" role="tabpanel" aria-labelledby="pills-info-tab">
			<ul class="list-group">
				<li class="list-group-item">Email: <%= @current_user.email %>
					<% if @current_user.email_confirmed %>
						<span class="badge bg-secondary align-middle" title="Verified" data-toggle="tooltip" data-placement="right">
							<%= octicon 'check', fill: 'lime' %>
						</span>
					<% else %>
						<span class="badge bg-secondary align-middle" title="Not Verified" data-toggle="tooltip" data-placement="right">
							<%= octicon 'x', fill: '#ffffff' %>
						</span>
					<% end %>
				</li>
				<li class="list-group-item">Permission Level: <%= case @current_user.permission_level; when 1; 'Admin'; when 0; 'Normal User'; end %></li>
				<li class="list-group-item">Created At: <%= @current_user.created_at.in_time_zone("Central Time (US & Canada)").strftime("%-I:%M %p, %b %-d, %Y") %></li>
			</ul>
		</div>
		<div class="tab-pane fade" id="pills-account" role="tabpanel" aria-labelledby="pills-account-tab">
			b
		</div>
		<div class="tab-pane fade" id="pills-notifications" role="tabpanel" aria-labelledby="pills-notifications-tab">
			c
		</div>
	</div>
</div>